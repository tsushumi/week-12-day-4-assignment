# PostgreSQL (Supabase or Neon). Use the POOLED / transaction connection string if your provider offers one.
# Development: small pool.   connection_limit = max connections this app opens, pool_timeout = seconds to wait for a free one
DATABASE_URL="postgresql://user:pass@host:5432/db?connection_limit=5&pool_timeout=10"

# Production (set in the deployment environment, not here):
# DATABASE_URL="postgresql://user:pass@host:5432/db?connection_limit=20&pool_timeout=10"

NODE_ENV=development
PORT=3000

# Queries slower than this are logged as warnings
SLOW_QUERY_MS=100
# /health gives up on the database after this long and answers 503
HEALTH_TIMEOUT_MS=3000
